# Copy to .env (already gitignored) and fill in real values before deploying.
# Never commit the real .env — it holds a private key with real testnet funds.

MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Private key of the funded deployer account, 0x-prefixed. Get testnet MON
# from https://faucet.monad.xyz for whatever address this key controls.
PRIVATE_KEY=0xyour_private_key_here

# Optional: set only if the registry's publisher should be a different,
# already-funded address instead of the deployer above. The publisher is the
# sole account VeridraReceiptRegistry will accept publish() calls from.
# PUBLISHER_ADDRESS=0xyour_publisher_address_here
